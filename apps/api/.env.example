NODE_ENV=development
PORT=4000

# Local MongoDB (docker compose up -d mongo, or a local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/district8

# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=12h

# Comma-separated browser origins allowed to call the API and open sockets
CORS_ORIGINS=http://localhost:3000

# Express "trust proxy": lets rate limiting see the real client IP forwarded by the Next.js admin proxy
TRUST_PROXY=loopback

# Demo admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@district8.local
SEED_ADMIN_PASSWORD=District8!Pool-PS5-2026
SEED_ADMIN_NAME=Arena Manager
