# MongoDB connection string. Locally: mongodb://127.0.0.1:27017/district8 (docker compose up -d mongo).
# On Vercel: your MongoDB Atlas string (Storage → Marketplace → MongoDB Atlas adds it for you).
MONGODB_URI=mongodb://127.0.0.1:27017/district8

# At least 32 random characters; signs admin sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=12h

# Admin account created by `npm run seed`. Change the password before seeding a real database.
SEED_ADMIN_EMAIL=admin@district8.local
SEED_ADMIN_PASSWORD=District8!Pool-PS5-2026
SEED_ADMIN_NAME=Arena Manager

# "true" runs the customer screens on an in-browser mock (no database needed).
NEXT_PUBLIC_USE_MOCK=false

# Comma-separated image hosts next/image may optimize (food photos). Other hosts still render, unoptimized.
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com

# Optional real admin device push. Generate once with `npx web-push generate-vapid-keys`.
# Keep these values stable; never commit the private key. Push is disabled if these are unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@district8.example
