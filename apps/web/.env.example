# Base URL of the NestJS API (apps/api). Also used for the socket.io connection.
NEXT_PUBLIC_API_URL=http://localhost:4000

# "true" serves in-browser mock data for the customer screens (no API needed).
# The admin panel always uses the real API.
NEXT_PUBLIC_USE_MOCK=false

# Comma-separated image hosts next/image may optimize (food photos).
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com

# Server-side only: where the Next.js admin proxy forwards requests. Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:4000
